# Copia este archivo como .env.local y pega tus datos de Supabase
# (Supabase → Project Settings → API / API Keys). .env.local no se sube a GitHub.
# Después corre "npm run verificar" para comprobar la conexión.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Solo la clave PUBLICABLE (sb_publishable_...). Nunca la secreta (sb_secret_...).
VITE_SUPABASE_KEY=tu-clave-publicable
